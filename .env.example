# Copy this file to `.env` and fill in your key. `.env` is git-ignored —
# never commit real keys or personal data (ADR-0002).

# Required: your GLM Coding Plan API key (https://open.bigmodel.cn/).
INTERVIEW_COACH_API_KEY=your-key-here

# Optional overrides — the defaults are shown. A real environment variable
# with the same name wins over a value in this file.
#INTERVIEW_COACH_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#INTERVIEW_COACH_MODEL=glm-5.3
