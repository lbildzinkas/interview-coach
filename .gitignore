# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- uv ---------------------------------------------------------------------
# The virtualenv is local; uv.lock IS committed (https://docs.astral.sh/uv/concepts/projects/)
.venv/

# --- Tool caches --------------------------------------------------------------
.pytest_cache/   # pytest https://docs.pytest.org/en/stable/how-to/cache.html
.ruff_cache/     # ruff https://docs.astral.sh/ruff/

# --- Local-only data (never commit these; see README.md) -----------------------
