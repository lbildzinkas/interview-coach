%% RAG ingestion: from the sources list to the search indexes.
%% Sources: ADR-0002 (study material stays out of the repo), ADR-0003 (LanceDB, in-process models).
flowchart LR
    subgraph legend["Legend"]
        direction LR
        lgBuilt["Built"]:::built
        lgReview["In review<br>open pull request"]:::review
        lgPlanned["Planned<br>milestone named"]:::planned
    end

    sources["sources.yaml<br>the sources list, committed"]:::review
    download["coach setup<br>downloads pinned sources at setup"]:::review
    raw[("data/study-material/<br>git-ignored, never committed")]:::review
    clean["Clean<br>strip MDX components<br>and images, drop<br>link-list sections<br>M0"]:::planned
    chunk["Chunk by markdown<br>headings, heading-path<br>prefix, about 512 tokens,<br>stable chunk ids<br>M0"]:::planned
    embed["Embed in-process<br>bge-small-en-v1.5 via<br>sentence-transformers<br>M0"]:::planned
    lance[("LanceDB table<br>vector index and<br>full-text index<br>M0")]:::planned
    bm25[("bm25s index<br>kept for comparison<br>M0")]:::planned
    undecided["Undecided: M1 experiments<br>test a GLM-Flash context<br>line per chunk and the<br>heading-path prefix on and<br>off, so this path may change"]:::note

    sources --> download
    download --> raw
    raw -.-> clean
    clean -.-> chunk
    chunk -.-> embed
    embed -.-> lance
    chunk -.-> lance
    chunk -.-> bm25
    chunk -.- undecided

    classDef built fill:#d1fae5,stroke:#047857,color:#064e3b
    classDef review fill:#fef3c7,stroke:#b45309,color:#78350f
    classDef planned fill:#f3f4f6,stroke:#6b7280,color:#374151,stroke-dasharray:5 3
    classDef note fill:#ffffff,stroke:#9ca3af,color:#4b5563
